# Secrets and personal files - never commit
.env
*.xlsx

# Local runtime data (SQLite DB, local storage, temp files)
data/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Large generated test outputs (keep small json/srt/csv, drop big media)
testpack/outputs/**/*.mp4
testpack/outputs/**/*.wav
testpack/outputs/**/*.mp3

# Tools downloaded on demand (scripts/tunnel.ps1 puts cloudflared.exe here)
tools/bin/

# My own voice recordings (privacy): kept on my PC only, never committed
testpack/inputs/*_myvoice.*
testpack/inputs/my_voice/
# Live-run videos stay local
testpack/live/**/*.mp4
