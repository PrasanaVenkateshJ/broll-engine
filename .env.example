# Copy this file to .env and change the values.  (PowerShell: Copy-Item .env.example .env)
# .env is git-ignored: real secrets NEVER go into git.
# Every setting the app reads is listed here (see app/config.py).

# ---------- General ----------
# App name shown in logs.
APP_NAME=broll-engine
# App version reported in logs / docs.
APP_VERSION=0.2.0
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Public address of the API, used in links inside callbacks. Empty = use the request's own address.
PUBLIC_BASE_URL=http://localhost:8000

# ---------- Auth + rate limit ----------
# Comma-separated bearer tokens allowed to call /api/v1. EMPTY = auth OFF (local dev only!).
API_TOKENS=dev-token
# Max POST requests (new jobs + clip swaps) per token per minute (0 = no limit).
# Over the limit -> 429 RATE_LIMITED with a Retry-After header (seconds to wait).
RATE_LIMIT_POST_PER_MINUTE=30
# Max GET requests (job status + file downloads) per token per minute (0 = no limit). Same 429 rule.
RATE_LIMIT_GET_PER_MINUTE=600
# Most jobs GET /api/v1/jobs may return in one answer (?limit=1..this).
JOBS_LIST_MAX=100
# Cost guard for a paid live demo: max NEW jobs (incl. clip swaps) per UTC day, all tokens together.
# Over it -> 429 DAILY_LIMIT_REACHED until midnight UTC. 0 = no cap (local / docker compose).
DEMO_MAX_JOBS_PER_DAY=0
# Same, per UTC calendar month. Over it -> 429 MONTHLY_LIMIT_REACHED until the 1st of next month (UTC).
# 0 = no cap (local / docker compose).
DEMO_MAX_JOBS_PER_MONTH=0

# ---------- Studio (web UI) ----------
# true = serve the B-roll Studio web page at GET / (its files under /studio/). false = API only.
STUDIO_ENABLED=true
# Folder with the Studio files. Empty = app/studio next to the code.
STUDIO_DIR=
# Sites allowed to show the Studio inside a frame, space-separated (e.g. https://huggingface.co for a
# Hugging Face Space page). Empty = no site may frame it.
STUDIO_FRAME_ANCESTORS=

# ---------- Database ----------
# SQLite file for jobs + idempotency keys. (Docker overrides this to /app/data/broll.db.)
DATABASE_URL=sqlite:///./data/broll.db
# SQLite journal: WAL (readers + a writer at once; needs shared memory = a normal local disk) or DELETE
# (plain journal file; the cautious choice on a network-style disk such as a Modal Volume).
SQLITE_JOURNAL_MODE=WAL

# ---------- Storage ----------
# "local" = save files in LOCAL_STORAGE_DIR (my PC). "s3" = MinIO / S3 (Docker, CI, deployment).
STORAGE_BACKEND=local
# Folder used when STORAGE_BACKEND=local.
LOCAL_STORAGE_DIR=./data/storage
# MinIO / S3 address (Docker overrides this to http://minio:9000).
S3_ENDPOINT_URL=http://localhost:9000
# MinIO / S3 access key (also the MinIO admin user in docker compose).
S3_ACCESS_KEY=minioadmin
# MinIO / S3 secret key (also the MinIO admin password in docker compose).
S3_SECRET_KEY=minioadmin
# Bucket that holds all job files.
S3_BUCKET=broll
# S3 region (MinIO ignores it, but boto3 needs one).
S3_REGION=us-east-1

# ---------- Signed download links ----------
# Secret used to sign download links. CHANGE THIS in any shared deployment.
FILE_LINK_SECRET=change-me-file-link-secret
# How long a download link works, in seconds.
FILE_LINK_TTL_SECONDS=3600

# ---------- Uploads ----------
# Largest upload accepted, in MB. Bigger -> 413 FILE_TOO_LARGE.
MAX_UPLOAD_MB=100
# File extensions accepted for the "audio" upload field.
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,m4a
# Folder for temporary files while working.
WORK_DIR=./data/work

# ---------- Callbacks ----------
# Secret for X-IncuBrix-Signature = hex HMAC-SHA256(raw body, CALLBACK_SECRET). CHANGE THIS.
CALLBACK_SECRET=change-me-callback-secret
# Retries after the first failed callback attempt.
CALLBACK_MAX_RETRIES=3
# First wait between retries in seconds; it doubles each time (1, 2, 4 ...).
CALLBACK_BACKOFF_SECONDS=1.0
# How long to wait for the receiver to answer, in seconds.
CALLBACK_TIMEOUT_SECONDS=10.0

# ---------- Worker ----------
# How many jobs one worker process runs at the same time.
WORKER_CONCURRENCY=2
# How often an idle worker checks for new jobs, in seconds.
WORKER_POLL_SECONDS=1.0
# true = keep each job's temp folder (WORK_DIR/<job_id>) after the job, for debugging.
KEEP_WORK_FILES=false

# ---------- FFmpeg ----------
# Name or full path of the ffmpeg / ffprobe programs.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# Longest time one ffmpeg call may run, in seconds.
FFMPEG_TIMEOUT_SECONDS=600

# ---------- Intake (input checks) ----------
# Longest narration accepted, in seconds. Longer -> FILE_TOO_LONG.
MAX_AUDIO_SECONDS=600
# Largest audio_url download, in MB. Bigger -> FILE_TOO_LARGE.
MAX_DOWNLOAD_MB=100
# Total time allowed for downloading audio_url, in seconds. Slower -> DOWNLOAD_FAILED.
DOWNLOAD_TIMEOUT_SECONDS=60
# All audio is converted to mono WAV at this sample rate (Hz).
AUDIO_SAMPLE_RATE=48000

# ---------- Text to speech ----------
# "kokoro" (real voice, Kokoro-82M, Apache-2.0) or "mock" (a plain tone; tests / CI).
TTS_PROVIDER=mock
# Hugging Face model id for Kokoro.
KOKORO_REPO_ID=hexgrad/Kokoro-82M
# Speaking speed for Kokoro (1.0 = normal).
KOKORO_SPEED=1.0
# Our voice names -> kokoro "language code:voice id". en-IN uses a Hindi speaker voice reading English.
TTS_VOICE_MAP=en-US-female=a:af_heart,en-US-male=a:am_michael,en-GB-female=b:bf_emma,en-GB-male=b:bm_george,en-IN-female=a:hf_alpha,en-IN-male=a:hm_omega,hi-IN-female=h:hf_alpha,hi-IN-male=h:hm_omega
# Scene-list input: seconds of silence after each scene's narration.
SCENE_PAUSE_SECONDS=0.3
# Finished TTS audio is reused for the same text + voice + model + speed. Empty = off.
TTS_CACHE_DIR=./data/tts_cache
# Mock TTS: words per second (sets the length of its tone).
MOCK_WORDS_PER_SECOND=2.5

# ---------- Transcription ----------
# "whisper" (faster-whisper, MIT) or "mock" (spreads the known text evenly; tests / CI).
TRANSCRIBE_PROVIDER=mock
# Whisper model size: tiny, base, small, medium ...
WHISPER_MODEL=small
# cpu or cuda.
WHISPER_DEVICE=cpu
# int8 = small and fast on a CPU.
WHISPER_COMPUTE_TYPE=int8
# Beam search width (higher = a bit more accurate, slower).
WHISPER_BEAM_SIZE=5
# Language code like "en" or "hi". Empty = detect automatically.
WHISPER_LANGUAGE=
# true = skip parts with no voice (helps with music); timestamps stay correct.
WHISPER_VAD_FILTER=true
# Non-English narration: Whisper also translates the speech to English, used ONLY for footage search
# (captions stay in the spoken language). false = search with the original text.
TRANSLATE_FOR_SEARCH=true
# Mock transcriber: text used for uploaded audio (it cannot really listen).
MOCK_TRANSCRIPT=This is a mock transcript. The mock adapter does not listen to the audio.

# ---------- Speech checks ----------
# Loudest moment below this (dB) = silent file -> NO_SPEECH_DETECTED.
SILENCE_MAX_VOLUME_DB=-45
# Quieter than this (dB) for at least SILENCE_MIN_SECONDS counts as silence.
SILENCE_NOISE_DB=-45
SILENCE_MIN_SECONDS=0.5
# Less non-silent audio than this (seconds) -> NO_SPEECH_DETECTED.
MIN_SOUND_SECONDS=0.5
# Fewer recognised words per minute of sound than this -> MUSIC_ONLY_AUDIO.
MUSIC_MIN_WORDS_PER_MINUTE=20
# Whisper's average "no speech" probability above this -> MUSIC_ONLY_AUDIO.
MUSIC_MAX_NO_SPEECH_PROB=0.6
# Average word confidence below this -> MUSIC_ONLY_AUDIO.
MUSIC_MIN_WORD_PROB=0.3

# ---------- Scenes ----------
# Shorter scenes are merged with a neighbour; longer ones are split.
MIN_SCENE_SECONDS=2.0
MAX_SCENE_SECONDS=8.0
# A gap between two words at least this long (seconds) counts as a phrase pause.
PAUSE_SECONDS=0.35

# ---------- Captions ----------
# Max characters per caption line and max lines per caption.
CAPTION_MAX_CHARS_PER_LINE=42
CAPTION_MAX_LINES=2
# Longest time one caption stays on screen, in seconds.
CAPTION_MAX_SECONDS=6.0
# Keep a caption up this long after its last word, in seconds.
CAPTION_LINGER_SECONDS=0.4
# Font for burned-in captions (falls back to a similar font if missing).
CAPTION_FONT=Arial
# Caption language (Whisper code) -> font. Text with Tamil / Devanagari letters gets that font even without
# a language code. The Noto fonts ship in app/fonts (SIL OFL), so Windows, Docker and Modal look the same.
CAPTION_FONTS_BY_LANGUAGE=ta=Noto Sans Tamil,hi=Noto Sans Devanagari,mr=Noto Sans Devanagari,ne=Noto Sans Devanagari
# Size factor per font so every script looks about as big (Noto Sans Devanagari draws small letters).
CAPTION_FONT_SCALES=Noto Sans Devanagari=1.4
# Folder of caption font files for FFmpeg (fontsdir). Empty = app/fonts.
CAPTION_FONTS_DIR=

# ---------- Render ----------
# Frames per second of every output video.
RENDER_FPS=30
# libx264 speed preset (ultrafast ... veryslow) and quality (lower CRF = better, bigger).
VIDEO_PRESET=veryfast
VIDEO_CRF=23
# AAC audio bitrate of the output videos.
AUDIO_BITRATE=192k
# Scene segments rendered at the same time (each its own ffmpeg). 1 = one after the other.
RENDER_WORKERS=3

# ---------- Reproducibility ----------
# One seed for LLM sampling, mock providers and generated card colours.
SEED=1234

# ---------- Network safety (SSRF) ----------
# false = refuse audio_url / footage URLs that point to private, loopback or link-local addresses.
# Only tests set true (they use local servers). Keep false everywhere else.
ALLOW_PRIVATE_URLS=false

# ---------- Scene understanding ----------
# "groq" (LLM, needs GROQ_API_KEY; falls back to rules + a warning if it fails),
# "rules" (offline sense dictionary) or "mock" (tests / CI).
UNDERSTAND_PROVIDER=mock
# Groq API key (console.groq.com). Put the real key ONLY in .env.
GROQ_API_KEY=
# Groq's OpenAI-compatible endpoint.
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Groq model id. gpt-oss is Apache-2.0; any Groq chat model with JSON mode works.
LLM_MODEL=openai/gpt-oss-120b
# Seconds to wait for one LLM answer.
LLM_TIMEOUT_SECONDS=30
# 0 = always the most likely answer, so the same script gives the same queries (repeatable).
LLM_TEMPERATURE=0
# Extra tries after a failed LLM call.
LLM_RETRIES=1
# Scenes per LLM request (long scripts go in batches; each batch also gets the whole script).
LLM_BATCH_SIZE=6
# HTTP 429 from the LLM: wait its retry-after, at most this long per wait.
LLM_MAX_RETRY_AFTER_SECONDS=30.0
# All rate-limit waits of one job together; after that the remaining scenes use the rules.
LLM_MAX_WAIT_SECONDS=120.0
# gpt-oss reasoning_effort (low / medium / high). Empty = the provider's default.
LLM_REASONING_EFFORT=
# Search queries per scene (meaning, metaphor, setting, action, mood).
QUERIES_PER_SCENE=5
# fast | balanced | best: fills in QUERIES_PER_SCENE, PROVIDER_PAGES, MAX_CANDIDATES_PER_SOURCE, EARLY_EXIT,
# MULTI_FRAME_TOP_K, VLM_TOP_K, VLM_MAX_SCENES_PER_JOB, VLM_JUDGE_CONFIDENT unless you set them yourself (fast = no judge).
QUALITY_MODE=balanced
# The whole story is sensitive (calm rules for EVERY scene) from this many sensitive scenes.
STORY_SENSITIVE_MIN_SCENES=2
# ...or from this share of sensitive scenes (or when the LLM says so).
STORY_SENSITIVE_MIN_SHARE=0.3

# ---------- Footage providers ----------
# Order in which sources are tried for each scene. Real order (my PC):
#   pixabay_video,pixabay_image_motion,wikimedia,generated
# Docker / CI default: mock,generated (no keys, no network). Also available: pexels.
PROVIDER_ORDER=mock,generated
# Comma-separated providers to switch off, e.g. pixabay_video.
PROVIDERS_DISABLED=
# JSON file re-read before every search, to switch a provider off DURING a job:
#   {"disabled": ["pixabay_video"]}
PROVIDERS_OVERRIDE_FILE=./data/providers_override.json
# Seconds to wait for one provider search.
PROVIDER_TIMEOUT_SECONDS=15
# Results asked for per search query.
PROVIDER_RESULTS_PER_QUERY=8
# Result pages per query; fetched as ONE request of RESULTS x PAGES where the API allows (same results, fewer calls).
PROVIDER_PAGES=1
# Most candidates of one source scored per scene, round-robin over the queries (CLIP is the slow part). 0 = no cap.
MAX_CANDIDATES_PER_SOURCE=15
# Pass 1 also downloads + checks each scene's likely winner in parallel (same choices, less waiting).
PREFETCH_CLIPS=true
# Score candidates EARLY_EXIT_STEP at a time; stop when one clearly passes (rest scored only if needed).
EARLY_EXIT=true
EARLY_EXIT_STEP=6
# At most this many queries per scene for these sources (name=n,...): small free quotas.
PROVIDER_MAX_QUERIES=wikimedia=3,openverse=2
# Client-side request limit per API (name=n,...), so a long job waits instead of getting HTTP 429.
PROVIDER_REQUESTS_PER_MINUTE=pixabay=90,openverse=18
# After an HTTP 429 a source is skipped for its retry-after, at least this long.
PROVIDER_COOLDOWN_SECONDS=60.0
# Openverse image search endpoint (no key; CC0 / Public Domain Mark / CC BY only).
OPENVERSE_API_URL=https://api.openverse.org/v1/images/
# Footage speed (same choices, less waiting). Scenes searched + scored at the same time; the choice
# itself is always made one scene at a time, in scene order. 1 = one scene after the other.
FOOTAGE_WORKERS=4
# Preview pictures downloaded at the same time (per scene), and the time limit for one.
PREVIEW_WORKERS=8
PREVIEW_TIMEOUT_SECONDS=8
# Search results + preview pictures are reused by later jobs for this long (0 = off).
# Pixabay's API terms: "requests must be cached for 24 hours".
FOOTAGE_CACHE_SECONDS=86400
FOOTAGE_CACHE_DIR=./data/footage_cache
# Pictures CLIP looks at in one go.
CLIP_BATCH_SIZE=32
# Load the CLIP model when the worker starts (not inside the first job).
CLIP_PRELOAD=true
# Pixabay key (pixabay.com/api/docs) - used by pixabay_video AND pixabay_image_motion. Only in .env.
PIXABAY_API_KEY=
PIXABAY_VIDEO_API_URL=https://pixabay.com/api/videos/
PIXABAY_IMAGE_API_URL=https://pixabay.com/api/
# Pexels has paused new API keys: leave empty and pexels is skipped.
PEXELS_API_KEY=
PEXELS_VIDEO_API_URL=https://api.pexels.com/videos/search
# Wikimedia Commons API (no key).
WIKIMEDIA_API_URL=https://commons.wikimedia.org/w/api.php
# Wikimedia REQUIRES a contact (email or URL) in the User-Agent, else HTTP 403 and the provider
# is skipped. Format: name/version (URL; email)
WIKIMEDIA_USER_AGENT=broll-engine/0.3 (set WIKIMEDIA_USER_AGENT to include your email or project URL)
# Largest footage download in MB, and the time limit for one download in seconds.
MAX_CLIP_DOWNLOAD_MB=80
CLIP_DOWNLOAD_TIMEOUT_SECONDS=60

# ---------- Ranking ----------
# "clip" = open_clip scores previews against the scene meaning; "mock" = word overlap (tests / CI).
RANK_SCORER=mock
# open_clip model + weights (both MIT).
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k
# A stock clip is used only if its CLIP score is at least this.
STOCK_MIN_SCORE=0.22
# Small extra points that only change the ORDER of candidates (never pass/fail).
DURATION_BONUS=0.02
ORIENTATION_BONUS=0.02
# true = lines with a number/percentage get a number card (text from the narration only) instead of stock footage.
GENERATED_FOR_STATISTICS=true
# true = a statistic line gets real footage of its topic with the number drawn on it as a badge; a plain number card only if no clip passes. false = straight to a number card.
STATISTIC_OVERLAY=true
# Prompt ensembling: each query is encoded with these prompts ({q} = the query) and averaged.
CLIP_PROMPTS=a stock video of {q}|a photo of {q}|{q}
# A candidate's score = mean of its best N query similarities.
SCORE_TOP_QUERIES=3
# The best N video candidates per source also get extra frames; score = mean over thumbnail + frames. 0 = off.
MULTI_FRAME_TOP_K=2
# Where the extra frames are taken (fractions of the clip length).
MULTI_FRAME_POSITIONS=0.3,0.7
# Largest small rendition downloaded for the extra frames.
MULTI_FRAME_MAX_MB=15
# CLIP prompts for text-heavy pictures (slides, screenshots, posters), '|'-separated.
TEXT_PROMPTS=a screenshot of a document full of text|a presentation slide with text|a poster with large printed words|a page of a printed newspaper
# Text-heavy probability above this -> TEXT_PENALTY off the ORDER score (never the threshold).
TEXT_PENALTY_PROB=0.5
# Order-score penalty for a text-heavy picture.
TEXT_PENALTY=0.03
# A passing stock video beats photo-motion unless the photo scores more than this higher; a video at threshold + margin skips the photo search.
PREFER_VIDEO_MARGIN=0.03
# Adaptive threshold: if nothing passes, a candidate >= STOCK_MIN_SCORE x (1 - this) may be used ONLY if the VLM judge rates it >= VLM_ACCEPT_SCORE.
RELATIVE_MARGIN=0.12
# Independent vision-language judge: groq | mock | none (off).
VLM_PROVIDER=none
# Groq vision model for the judge (qwen/qwen3.8-27b: Apache-2.0 weights, a Groq preview model).
VLM_MODEL=qwen/qwen3.8-27b
# Time limit for one judge request.
VLM_TIMEOUT_SECONDS=30.0
# Candidates judged per scene, drawn side by side in ONE picture (Groq counts 2,048 tokens per image).
VLM_TOP_K=3
# Width in pixels of each candidate in the judge's picture.
VLM_PANEL_WIDTH=256
# At most this many scenes judged per job, most uncertain first. 0 = all.
VLM_MAX_SCENES_PER_JOB=3
# Also judge confident scenes (best score >= STOCK_MIN_SCORE + PREFER_VIDEO_MARGIN)?
VLM_JUDGE_CONFIDENT=false
# A judged candidate rated this or lower (1-5) is dropped.
VLM_REJECT_SCORE=1
# Rating needed for the adaptive threshold.
VLM_ACCEPT_SCORE=4
# HTTP 429 from the judge: wait if retry-after is at most this, else stop judging for a while.
VLM_MAX_RETRY_AFTER_SECONDS=0.0
# Logo check (only for candidates that pass STOCK_MIN_SCORE): logo probability 0..1 = CLIP softmax over
# LOGO_PROMPTS + LOGO_NEUTRAL_PROMPTS ("|"-separated), summed over the logo prompts; the highest value of
# the whole picture and its LOGO_CROP_GRID x LOGO_CROP_GRID crops counts. prob > LOGO_REJECT_PROB ->
# rejected; prob > LOGO_PENALTY_PROB -> kept, but LOGO_PENALTY is taken off its order score. false = off.
# Calibrated on hand-labelled Pixabay thumbnails: testpack/calibration/logo_report.md.
LOGO_CHECK=true
# Logo prompts: things that SHOW a logo / brand name.
LOGO_PROMPTS=a photo of a laptop with an apple logo|a photo of a shop sign with a brand name|a photo of advertising billboards|a photo of a car covered in sponsor logos|a photo of a product with a printed brand name
# Neutral prompts: the same kinds of subjects WITHOUT a logo (prompts saying "no logos" do not work).
LOGO_NEUTRAL_PROMPTS=a photo of a laptop|a photo of a shop|a photo of a city street|a photo of a car|a photo of a product|a photo of a phone|a photo of people|a photo of nature|a photo of food|a close-up photo
# Crop grid for the logo check (3 = whole picture + 3x3 crops; 0 or 1 = whole picture only).
LOGO_CROP_GRID=3
# Logo probability above this -> candidate (or downloaded clip frame) rejected.
LOGO_REJECT_PROB=0.6
# Logo probability above this (and not above LOGO_REJECT_PROB) -> kept, but LOGO_PENALTY off its order score.
LOGO_PENALTY_PROB=0.4
LOGO_PENALTY=0.03
# Frames of the DOWNLOADED clip (spread over its length) that get the same logo test; one frame above
# LOGO_REJECT_PROB rejects the clip and the next candidate is tried. A still image has one picture, so it is checked once.
LOGO_FRAME_COUNT=3

# ---------- Clip fitting + look ----------
# A short clip may be slowed by up to this fraction (0.25 = 25 %), then it loops forward/backward.
MAX_SLOWDOWN=0.25
# Ken Burns zoom on still images (1.12 = 12 % closer by the end of the scene).
KEN_BURNS_ZOOM=1.12
# Frames sampled per clip to find the most interesting region for cropping.
SALIENCY_SAMPLE_FRAMES=5
# Subject-aware crop (RANK_SCORER=clip): colour frames sampled per clip; each crop window
# (left / centre / right / salient) is scored with CLIP against the scene meaning.
CROP_SAMPLE_FRAMES=3
# Best window this much (or more) BELOW the whole frame -> no window keeps the subject -> blurred fit.
CROP_BLUR_MARGIN=0.02
# Leave the salient / centre window only if another window scores more than this above it.
CROP_TIE_MARGIN=0.03
# Subject span = where localised detail stays >= this x its peak (crop near-tie rule).
CROP_SUBJECT_LEVEL=0.5
# ...at least the peak +- this fraction of the frame. A near-tie window whose edge falls inside it loses.
CROP_SUBJECT_PAD=0.06
# Brightness / colour normalisation: target mean luma (0-255), max brightness shift, target saturation.
# (Measured on real Pixabay clips in my first real run: YAVG 102-107, SATAVG 15-17.)
TARGET_LUMA=110
MAX_BRIGHTNESS_SHIFT=0.12
TARGET_SATURATION=18

# ---------- Quality checks ----------
# Black frames / frozen picture longer than this (seconds) count as a problem.
QA_BLACK_SECONDS=0.5
QA_FREEZE_SECONDS=2.0
# Max allowed difference between video and narration length (seconds).
QA_MAX_DRIFT_SECONDS=0.1
# How many other clips to try for a scene whose segment fails QA.
QA_RETRIES=1
